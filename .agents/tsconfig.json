{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": false,
    "noImplicitAny": false,
    "typeRoots": ["../api/node_modules/@types"],
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "*": ["../api/node_modules/*"]
    }
  },
  "include": ["skills/**/*"]
}
